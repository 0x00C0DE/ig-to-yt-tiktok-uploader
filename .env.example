# This project reads secrets from the process environment; it does not automatically load this file.
# Copy only the names you use into your shell or secret manager. Never commit populated values.

# Optional official TikTok Content Posting API user token.
TIKTOK_ACCESS_TOKEN=

# Optional absolute path to Python 3.9+ for the TikTokAutoUploader installer and adapter.
TIKTOK_PYTHON=

# Optional proxy variable. Reference its name with a TikTok account's proxyEnv setting.
TIKTOK_PROXY_URL=
