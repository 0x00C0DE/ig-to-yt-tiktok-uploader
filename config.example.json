{
  "chromeProfiles": {
    "creator": {
      "label": "Creator Chrome profile",
      "profileDirectory": "Default"
    },
    "work": {
      "label": "Work Chrome profile",
      "profileDirectory": "Profile 2"
    }
  },
  "downloader": {
    "type": "direct",
    "command": "yt-dlp"
  },
  "accounts": {
    "instagram": {},
    "tiktok": {
      "tt-main": {
        "label": "Main TikTok",
        "handle": "@tiktok_handle",
        "uploadMethod": "tiktok-auto-uploader",
        "loginMethod": "extension",
        "sessionName": "tiktok-main",
        "uploaderPath": ".vendor/TiktokAutoUploader",
        "pythonCommand": "python",
        "visibility": 0,
        "allowComment": true,
        "allowDuet": false,
        "allowStitch": false
      }
    },
    "youtube": {
      "yt-main": { "label": "Main YouTube channel", "handle": "@youtube_handle" }
    }
  },
  "defaults": {
    "mode": "publish",
    "headless": false,
    "downloadDirectory": "downloads",
    "uploadMethod": "extension",
    "enabledPlatforms": ["tiktok", "youtube"],
    "deepInstagramDiscovery": true,
    "deleteAfterYouTubeUpload": true,
    "instagramDiscoveryMethod": "extension",
    "chromeProfile": "creator"
  }
}
